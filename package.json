{
  "name": "acm2",
  "productName": "acm",
  "version": "1.1.1",
  "description": "Assistance control manager",
  "main": "main.js",
  "scripts": {
    "install:react": "npm --prefix react_app install",
    "rebuild": "electron-rebuild",
    "start": "electron .",
    "start:dev": "npx electronmon --trace-warnings .",
    "start:react": "npm --prefix react_app start",
    "postinstall": "electron-builder install-app-deps",
    "react-build": "npm --prefix react_app run build",
    "package": "electron-builder"
  },
  "keywords": [
    "electron",
    "reactjs",
    "typescript"
  ],
  "author": "Mario A. Herranz",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.diselstudio.acm",
    "productName": "acm",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "react_build/**/*",
      "!react_app/**/*",
      "database/**/*",
      "exportation/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "react_build/iconAcm.png"
    },
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
